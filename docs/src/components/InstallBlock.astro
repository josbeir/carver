---
import CodeBlock from './CodeBlock.astro';
import { version } from '../data/version';

const repo = 'https://github.com/josbeir/carver';
const releases = `${repo}/releases/latest`;
const bundle = `carver-${version}-x86_64.flatpak`;

const flatpakSteps = [
  {
    label: 'Add Flathub once, if needed',
    code: 'flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo',
  },
  {
    label: 'Verify the download',
    code: `sha256sum -c ${bundle}.sha256`,
  },
  {
    label: 'Install and launch',
    code: `flatpak install --user --or-update --bundle ./${bundle}\nflatpak run io.github.josbeir.Carver`,
  },
];

const appImage = `carver-${version}-x86_64.AppImage`;
const appImageSteps = [
  {
    label: 'Verify the download',
    code: `sha256sum -c ${appImage}.sha256`,
  },
  {
    label: 'Make it executable and run',
    code: `chmod +x ${appImage}\n./${appImage} --appimage-extract-and-run`,
  },
];
---

<section id="install" class="scroll-mt-24 border-t border-base-300/60 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4">
    <div class="max-w-3xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary">Install</p>
      <h2 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        Make room for your next idea
      </h2>
      <p class="mt-5 text-base/7 text-base-content/75">
        Get Carver {version} for Linux and start with a single note. Choose the recommended Flatpak
        download, or try the experimental AppImage on a newer system. Download its matching checksum
        file too, then follow the steps below.
      </p>
      <div class="mt-6">
        <a class="btn btn-primary" href={releases}>
          Download Carver
        </a>
      </div>
    </div>

    <div class="mt-12 grid gap-6 lg:grid-cols-2">
      <div class="card border border-base-300/70 bg-base-100">
        <div class="card-body gap-4">
          <div class="flex items-center gap-3">
            <h3 class="card-title text-xl">Flatpak</h3>
            <span class="badge badge-primary badge-sm">Recommended</span>
          </div>
          <p class="text-base/7 text-base-content/70">
            Flatpak takes care of the components Carver needs. If it asks to add Flathub, accept the
            prompt, or run the first command once.
          </p>
          {flatpakSteps.map((step) => (
            <CodeBlock label={step.label} code={step.code} />
          ))}
          <p class="text-sm/6 text-base-content/55">
            GitHub release bundles do not update automatically yet. To update, download the bundle
            from a newer release and run the same install command.
          </p>
        </div>
      </div>

      <div class="card border border-base-300/70 bg-base-100">
        <div class="card-body gap-4">
          <div class="flex items-center gap-3">
            <h3 class="card-title text-xl">AppImage</h3>
            <span class="badge badge-warning badge-sm badge-outline">Experimental</span>
          </div>
          <p class="text-base/7 text-base-content/70">
            Targets Ubuntu 26.04 or a compatible newer system with
            <code class="font-mono text-sm">glycin-loaders</code> and Bubblewrap installed. Use
            Flatpak on older distributions.
          </p>
          {appImageSteps.map((step) => (
            <CodeBlock label={step.label} code={step.code} />
          ))}
          <p class="text-sm/6 text-base-content/55">
            The command above works without FUSE. If FUSE is installed, you can also launch the
            AppImage directly. AppImage and Flatpak keep separate note libraries, so your notes will
            not automatically appear when switching between them.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
