---
import CodeBlock from './CodeBlock.astro';
import { version } from '../data/version';

const repo = 'https://github.com/josbeir/carver';
const releases = `${repo}/releases/latest`;
const bundle = `carver-${version}-x86_64.flatpak`;

const flatpakSteps = [
  {
    label: 'Add Flathub once, if needed',
    code: 'flatpak remote-add --if-not-exists --user flathub https://dl.flathub.org/repo/flathub.flatpakrepo',
  },
  {
    label: 'Verify the download',
    code: `sha256sum -c ${bundle}.sha256`,
  },
  {
    label: 'Install and launch',
    code: `flatpak install --user --or-update --bundle ./${bundle}\nflatpak run io.github.josbeir.Carver`,
  },
];
---

<section
  id="install"
  class="scroll-mt-24 border-t border-base-300/60 bg-base-200/50 py-20 sm:py-28"
>
  <div class="mx-auto max-w-6xl px-4">
    <div class="mx-auto max-w-3xl text-center">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary">Install</p>
      <h2 class="text-4xl font-semibold tracking-tight text-balance sm:text-5xl">
        Make room for your next idea
      </h2>
      <p class="mt-5 text-base/7 text-base-content/75">
        Get Carver {version} for Linux and start with a single note. Download the Flatpak bundle and
        its matching checksum file, then follow the steps below.
      </p>
      <div class="mt-6">
        <a class="btn btn-primary" href={releases}>
          Download Carver
        </a>
      </div>
    </div>

    <div class="mx-auto mt-10 max-w-3xl">
      <div class="card border border-base-300/70 bg-base-100">
        <div class="card-body gap-4">
          <div class="flex items-center gap-3">
            <h3 class="card-title text-xl">Flatpak</h3>
            <span class="badge badge-primary badge-sm">Recommended</span>
          </div>
          <p class="text-base/7 text-base-content/70">
            Flatpak takes care of the components Carver needs. If it asks to add Flathub, accept the
            prompt, or run the first command once.
          </p>
          {flatpakSteps.map((step) => (
            <CodeBlock label={step.label} code={step.code} />
          ))}
          <p class="text-sm/6 text-base-content/55">
            GitHub release bundles do not update automatically yet. To update, download the bundle
            from a newer release and run the same install command.
          </p>
        </div>
      </div>
    </div>
    <p class="mt-5 text-center text-sm/6 text-base-content/65">
      Looking for other formats?{' '}
      <a class="link link-primary" href={releases}>
        Visit the releases page
      </a>
      .
    </p>
  </div>
</section>
