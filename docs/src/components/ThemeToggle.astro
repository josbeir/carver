---
// Theme toggle. The icon is CSS-driven (no JS) and the script only flips the
// `data-theme` attribute plus the persisted preference.
---

<button
  type="button"
  data-theme-toggle
  class="btn btn-ghost btn-square btn-sm"
  aria-label="Toggle color theme"
  title="Toggle color theme"
>
  <!-- Shown in the light theme: switch to dark. -->
  <svg
    class="size-5 dark:hidden"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path>
  </svg>
  <!-- Shown in the dark theme: switch to light. -->
  <svg
    class="hidden size-5 dark:block"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
  </svg>
</button>

<script>
  const THEME_KEY = 'carver-theme';

  function applyTheme(theme: string) {
    document.documentElement.dataset.theme = theme;
    try {
      localStorage.setItem(THEME_KEY, theme);
    } catch {
      // Ignore storage failures (private mode); the in-memory theme still applies.
    }
  }

  for (const button of document.querySelectorAll('[data-theme-toggle]')) {
    button.addEventListener('click', () => {
      const current = document.documentElement.dataset.theme;
      applyTheme(current === 'carver-dark' ? 'carver' : 'carver-dark');
    });
  }
</script>
