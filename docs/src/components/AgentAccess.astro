---
import anthropic from '../assets/agent-icons/anthropic.svg?raw';
import codex from '../assets/agent-icons/codex-openai.svg?raw';
import copilot from '../assets/agent-icons/copilot.svg?raw';
import opencode from '../assets/agent-icons/opencode.svg?raw';
import type { Shot } from '../data/screenshots';
import CodeBlock from './CodeBlock.astro';
import ScreenshotSection from './ScreenshotSection.astro';

interface Props {
  shot?: Shot;
}

const { shot } = Astro.props;

const clients = [
  { name: 'Claude Code', logo: anthropic },
  { name: 'Codex', logo: codex },
  { name: 'Copilot', logo: copilot },
  { name: 'OpenCode', logo: opencode },
];

const configure = [
  'carver-mcp configure claude-code',
  'carver-mcp configure codex',
  'carver-mcp configure copilot',
  'carver-mcp configure vscode',
  'carver-mcp configure opencode',
  'carver-mcp configure generic',
].join('\n');

const allowWrite = 'carver-mcp configure claude-code --allow-write';
---

<ScreenshotSection
  id="agent"
  eyebrow="Agent access"
  title="Turn your notes into project context"
  shot={shot}
  reverse
>
  <p>
    Write down the rough ideas, meeting notes, and plans, then let a local agent search and read
    that context while it helps you think. The useful result stays in your library instead of
    disappearing into a chat transcript.
  </p>

  <ul class="flex flex-wrap gap-2">
    {clients.map((client) => (
      <li class="inline-flex items-center gap-2 rounded-full border border-base-300/70 bg-base-100 px-3 py-1.5 text-sm font-medium">
        <span
          class="inline-flex size-4 items-center justify-center [&>svg]:size-full"
          aria-hidden="true"
          set:html={client.logo}
        />
        {client.name}
      </li>
    ))}
  </ul>

  <CodeBlock label="Set up a client" code={configure} />

  <p class="text-sm text-base-content/60">
    The server is read-only by default. Opt into reversible note changes explicitly:
  </p>
  <CodeBlock label="Enable note changes" code={allowWrite} />

  <p class="text-sm text-base-content/60">
    It is a local stdio process, not a network service. It opens the same XDG-scoped library as the
    installed application, and permanent trash deletion, settings changes, raw database access, and
    managed asset bytes are never exposed.
  </p>
</ScreenshotSection>
