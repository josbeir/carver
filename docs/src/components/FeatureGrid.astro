---
interface Feature {
  icon: keyof typeof icons;
  title: string;
  body: string;
}

const icons = {
  pen: '<path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/>',
  code: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/>',
  paste:
    '<rect x="8" y="2" width="8" height="4" rx="1"/><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/>',
  image:
    '<rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="9" cy="9" r="1.5"/><path d="m21 15-4.5-4.5L3 21"/>',
  table: '<rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M3 15h18M9 3v18"/>',
  layers: '<path d="m12 2 9 5-9 5-9-5 9-5Z"/><path d="m3 12 9 5 9-5"/><path d="m3 17 9 5 9-5"/>',
  search: '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>',
  sparkles:
    '<path d="M12 3v4M12 17v4M3 12h4M17 12h4M6 6l2.5 2.5M15.5 15.5 18 18M18 6l-2.5 2.5M8.5 15.5 6 18"/>',
  monitor: '<rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/>',
  sliders: '<path d="M4 21v-7M4 10V3M12 21v-9M12 8V3M20 21v-5M20 12V3M1 14h6M9 8h6M17 16h6"/>',
  folder:
    '<path d="M4 20h16a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7l-2-2H4a2 2 0 0 0-2 2v12a2 2 0 0 0 2 2Z"/>',
} as const;

const features: Feature[] = [
  {
    icon: 'pen',
    title: 'Rich-text writing',
    body: 'Headings, inline formatting, lists, tasks, links, tables, and keyboard shortcuts.',
  },
  {
    icon: 'code',
    title: 'Carve source and preview',
    body: 'Rich editing, canonical .crv source, a read-only preview, and a synchronized split view.',
  },
  {
    icon: 'paste',
    title: 'Format-aware pasting',
    body: 'Paste Carve straight into the rich editor, or use “Paste as Markdown” to migrate to canonical Carve.',
  },
  {
    icon: 'table',
    title: 'Saved note Bases',
    body: 'Database-style views with frontmatter columns, filters, sorting, and search.',
  },
  {
    icon: 'image',
    title: 'Images that travel',
    body: 'Paste, resize, and keep managed images alongside the note source, never buried in a database.',
  },
  {
    icon: 'layers',
    title: 'Media sidebar',
    body: 'Browse and focus every image or managed file a note uses, and open them in native viewers.',
  },
  {
    icon: 'folder',
    title: 'Organized and recoverable',
    body: 'Categories, recent-note browsing, Trash restoration, and Undo for the everyday changes.',
  },
  {
    icon: 'search',
    title: 'Search, import, and export',
    body: 'Full-text and in-note search; Carve and Markdown import; Carve, Markdown, and PDF export.',
  },
  {
    icon: 'sparkles',
    title: 'Local agent access',
    body: 'Let an agent use your notes as context to find ideas and build plans, with opt-in, reversible changes.',
  },
  {
    icon: 'sliders',
    title: 'Preferences that fit',
    body: 'Choose your editing mode, source presentation, remote images, and formatting toolbar.',
  },
  {
    icon: 'monitor',
    title: 'Native GNOME by design',
    body: 'A responsive GTK4 and Libadwaita interface with light and dark themes and accessible controls.',
  },
];
---

<section id="features" class="scroll-mt-24 border-t border-base-300/60 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4">
    <div class="max-w-3xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary">Features</p>
      <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">
        Everything you need to write, organize, and find
      </h2>
      <p class="mt-5 text-base/7 text-base-content/75">
        Built as a real desktop application: fast, keyboard-friendly, and comfortable to live in
        every day.
      </p>
    </div>

    <ul class="mt-14 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {features.map((feature) => (
        <li class="flex gap-4">
          <span class="mt-0.5 inline-flex size-10 shrink-0 items-center justify-center rounded-xl bg-primary/10 text-primary">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="size-5"
              aria-hidden="true"
              set:html={icons[feature.icon]}
            />
          </span>
          <div>
            <h3 class="font-semibold">{feature.title}</h3>
            <p class="mt-1 text-sm/6 text-base-content/70">{feature.body}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>
