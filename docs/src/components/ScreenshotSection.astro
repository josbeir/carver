---
import type { Shot } from '../data/screenshots';
import ThemedScreenshot from './ThemedScreenshot.astro';

interface Props {
  id: string;
  eyebrow?: string;
  title: string;
  /** Screenshot to pair with the copy; omit while a capture is still pending. */
  shot?: Shot;
  /** Place the screenshot on the left at large sizes. */
  reverse?: boolean;
}

const { id, eyebrow, title, shot, reverse = false } = Astro.props;

const gridClass = shot ? 'grid items-center gap-12 lg:grid-cols-2' : 'max-w-3xl';
const textClass = shot && reverse ? 'lg:order-2' : '';
const shotClass = reverse ? 'lg:order-1' : '';
---

<section id={id} class="scroll-mt-24 border-t border-base-300/60 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4">
    <div class={gridClass}>
      <div class={textClass}>
        {eyebrow && (
          <p class="mb-3 text-sm font-semibold uppercase tracking-wider text-primary">{eyebrow}</p>
        )}
        <h2 class="text-3xl font-semibold tracking-tight text-balance sm:text-4xl">{title}</h2>
        <div class="mt-5 space-y-4 text-base/7 text-base-content/75">
          <slot />
        </div>
      </div>

      {shot && (
        <div class={shotClass}>
          <ThemedScreenshot shot={shot} />
        </div>
      )}
    </div>
  </div>
</section>
