---
import { Picture } from 'astro:assets';

import type { Shot } from '../data/screenshots';

interface Props {
  shot: Shot;
  /** Loading strategy; the hero passes "eager". */
  loading?: 'eager' | 'lazy';
  /** Responsive sizes hint for the rendered layout. */
  sizes?: string;
  class?: string;
}

const {
  shot,
  loading = 'lazy',
  sizes = '(min-width: 1024px) 720px, 100vw',
  class: className = '',
} = Astro.props;

const widths = [640, 960, 1280, 1600, 2048, 2560];
// Higher than the sharp defaults: screenshots carry lots of small text, where
// AVIF/WebP artifacts read as softness.
const quality = 84;
---

<figure
  class={`overflow-hidden rounded-2xl border border-base-300/70 bg-base-200 shadow-lg shadow-black/10 dark:shadow-2xl dark:shadow-black/60 ${className}`}
>
  {/*
    Both theme variants are rendered and one is hidden with the `dark:` variant,
    so the image follows the site theme with no JavaScript and no wrong-theme
    flash. Only the visible variant is exposed to assistive technology.
  */}
  <span class="block dark:hidden">
    <Picture
      src={shot.light}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizes}
      quality={quality}
      alt={shot.alt}
      loading={loading}
      decoding="async"
      class="block h-auto w-full"
    />
  </span>
  <span class="hidden dark:block">
    <Picture
      src={shot.dark}
      formats={['avif', 'webp']}
      widths={widths}
      sizes={sizes}
      quality={quality}
      alt={shot.alt}
      loading={loading}
      decoding="async"
      class="block h-auto w-full"
    />
  </span>
  {shot.caption && (
    <figcaption class="border-t border-base-300/60 px-4 py-3 text-base text-base-content/70">
      {shot.caption}
    </figcaption>
  )}
</figure>
