---
import type { BaseViewSlide } from '../data/screenshots';
import ThemedScreenshot from './ThemedScreenshot.astro';

interface Props {
  slides: BaseViewSlide[];
  /** Accessible name for the carousel region. */
  label: string;
  /** Responsive sizes hint handed to each screenshot. */
  sizes?: string;
}

const {
  slides,
  label,
  sizes = '(min-width: 1152px) 744px, (min-width: 1024px) 65vw, calc(100vw - 32px)',
} = Astro.props;
---

<div class="carousel" data-carousel role="group" aria-roledescription="carousel" aria-label={label}>
  <div class="carousel__track" data-carousel-track tabindex="0" aria-label={`${label} screenshots`}>
    {slides.map((slide, index) => (
      <div
        class="carousel__slide"
        data-carousel-slide
        role="group"
        aria-roledescription="slide"
        aria-label={`${index + 1} of ${slides.length}: ${slide.label}`}
      >
        <ThemedScreenshot
          shot={{ ...slide.shot, caption: slide.label }}
          shadow="subtle"
          sizes={sizes}
        />
      </div>
    ))}
  </div>

  {slides.length > 1 && (
    <>
      <button
        type="button"
        class="carousel__button carousel__button--prev"
        data-carousel-prev
        aria-label={`Previous: ${label}`}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 6l-6 6 6 6" />
        </svg>
      </button>
      <button
        type="button"
        class="carousel__button carousel__button--next"
        data-carousel-next
        aria-label={`Next: ${label}`}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 6l6 6-6 6" />
        </svg>
      </button>
    </>
  )}
</div>

<script>
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
    if (!track) return;
    const slideCount = track.querySelectorAll('[data-carousel-slide]').length;
    const prev = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!prev || !next || slideCount < 2) return;

    const update = () => {
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };

    const goTo = (index: number) => {
      const clamped = Math.max(0, Math.min(slideCount - 1, index));
      track.scrollTo({ left: clamped * track.clientWidth, behavior: 'smooth' });
    };

    const nearest = () => Math.round(track.scrollLeft / Math.max(track.clientWidth, 1));

    prev.addEventListener('click', () => goTo(nearest() - 1));
    next.addEventListener('click', () => goTo(nearest() + 1));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .carousel {
    position: relative;
  }
  .carousel__track {
    display: flex;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scrollbar-width: none;
    /* Keep the focus ring inside the rounded screenshots. */
    border-radius: 0.75rem;
  }
  .carousel__track::-webkit-scrollbar {
    display: none;
  }
  .carousel__slide {
    flex: 0 0 100%;
    min-width: 100%;
    scroll-snap-align: center;
  }
  .carousel__button {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 9999px;
    background: rgb(20 20 24 / 55%);
    color: #fff;
    box-shadow: 0 4px 14px rgb(0 0 0 / 35%);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      opacity 140ms ease,
      background-color 140ms ease;
  }
  .carousel__button:hover:not(:disabled) {
    background: rgb(20 20 24 / 78%);
  }
  .carousel__button:disabled {
    opacity: 0;
    pointer-events: none;
  }
  .carousel__button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .carousel__button svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .carousel__button--prev {
    left: 0.75rem;
  }
  .carousel__button--next {
    right: 0.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .carousel__track {
      scroll-behavior: auto;
    }
  }
</style>
