---
import type { BaseViewSlide } from '../data/screenshots';
import ThemedScreenshot from './ThemedScreenshot.astro';

interface Props {
  slides: BaseViewSlide[];
  /** Accessible name for the carousel region. */
  label: string;
  /** Responsive sizes hint handed to each screenshot. */
  sizes?: string;
}

const {
  slides,
  label,
  sizes = '(min-width: 1152px) 744px, (min-width: 1024px) 65vw, calc(100vw - 32px)',
} = Astro.props;
---

<!-- Note: the root avoids daisyUI's `carousel` class on purpose. That component
     is itself an `overflow-x: scroll` scroller whose `display: inline-flex`
     would squash the layout. The track below is a native scroll-snap scroller
     with just enough gap and padding for the screenshot's drop shadow. -->
<div
  class="shot-carousel"
  data-carousel
  role="group"
  aria-roledescription="carousel"
  aria-label={label}
>
  <div
    class="shot-carousel__track"
    data-carousel-track
    tabindex="0"
    aria-label={`${label} screenshots`}
  >
    {slides.map((slide, index) => (
      <div
        class="shot-carousel__slide"
        data-carousel-slide
        role="group"
        aria-roledescription="slide"
        aria-label={`${index + 1} of ${slides.length}: ${slide.label}`}
      >
        <ThemedScreenshot shot={slide.shot} shadow="soft" sizes={sizes} loading="eager" />
        <p class="shot-carousel__caption">{slide.label}</p>
      </div>
    ))}
  </div>

  {slides.length > 1 && (
    <>
      <button
        type="button"
        class="shot-carousel__button shot-carousel__button--prev"
        data-carousel-prev
        aria-label={`Previous: ${label}`}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M15 6l-6 6 6 6" />
        </svg>
      </button>
      <button
        type="button"
        class="shot-carousel__button shot-carousel__button--next"
        data-carousel-next
        aria-label={`Next: ${label}`}
      >
        <svg
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M9 6l6 6-6 6" />
        </svg>
      </button>
    </>
  )}
</div>

<script>
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    const track = carousel.querySelector<HTMLElement>('[data-carousel-track]');
    const prev = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!track || !prev || !next) return;
    const slides = [...track.querySelectorAll<HTMLElement>('[data-carousel-slide]')];
    if (slides.length < 2) return;

    // Distance between two slide starts, including the flex gap.
    const step = () => slides[1].offsetLeft - slides[0].offsetLeft;
    const nearest = () => Math.round(track.scrollLeft / step());

    const update = () => {
      prev.disabled = track.scrollLeft <= 1;
      next.disabled = track.scrollLeft + track.clientWidth >= track.scrollWidth - 1;
    };

    const goTo = (index: number) => {
      const target = Math.max(0, Math.min(slides.length - 1, index));
      track.scrollTo({ left: target * step(), behavior: 'smooth' });
    };

    prev.addEventListener('click', () => goTo(nearest() - 1));
    next.addEventListener('click', () => goTo(nearest() + 1));
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  });
</script>

<style>
  .shot-carousel {
    position: relative;
  }
  /* The 1rem gap and matching padding give the drop shadow room while the clip
   * still ends exactly where the next slide begins, so no neighbour peeks in.
   * `margin` cancels the padding so the slides stay the width of the column. */
  .shot-carousel__track {
    display: flex;
    gap: 1rem;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    scroll-padding-inline: 1rem;
    scrollbar-width: none;
    padding: 1.5rem 1rem;
    margin: -1.5rem -1rem;
  }
  .shot-carousel__track::-webkit-scrollbar {
    display: none;
  }
  .shot-carousel__slide {
    flex: 0 0 100%;
    scroll-snap-align: start;
  }
  .shot-carousel__caption {
    /* Clear the screenshot's bottom drop shadow. */
    margin-top: 1.5rem;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.5;
    color: color-mix(in oklab, currentColor 70%, transparent);
  }
  .shot-carousel__button {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 9999px;
    background: rgb(20 20 24 / 55%);
    color: #fff;
    box-shadow: 0 4px 14px rgb(0 0 0 / 35%);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      opacity 140ms ease,
      background-color 140ms ease;
  }
  .shot-carousel__button:hover:not(:disabled) {
    background: rgb(20 20 24 / 78%);
  }
  .shot-carousel__button:disabled {
    opacity: 0;
    pointer-events: none;
  }
  .shot-carousel__button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .shot-carousel__button svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .shot-carousel__button--prev {
    left: 0.75rem;
  }
  .shot-carousel__button--next {
    right: 0.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .shot-carousel__track {
      scroll-behavior: auto;
    }
  }
</style>
