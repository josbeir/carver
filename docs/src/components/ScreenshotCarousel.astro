---
import type { BaseViewSlide } from '../data/screenshots';
import ThemedScreenshot from './ThemedScreenshot.astro';

interface Props {
  slides: BaseViewSlide[];
  /** Accessible name for the carousel region. */
  label: string;
  /** Responsive sizes hint handed to each screenshot. */
  sizes?: string;
}

const {
  slides,
  label,
  sizes = '(min-width: 1152px) 744px, (min-width: 1024px) 65vw, calc(100vw - 32px)',
} = Astro.props;
---

<!-- Note: the root avoids daisyUI's `carousel` class on purpose. That component
     is an `overflow-x: scroll` scroller, which would clip the screenshots'
     drop shadows and set `display: inline-flex` on the stage. -->
<div
  class="shot-carousel"
  data-carousel
  role="group"
  aria-roledescription="carousel"
  aria-label={label}
>
  <div class="shot-carousel__stage">
    {slides.map((slide, index) => (
      <div
        class="shot-carousel__slide"
        data-carousel-slide
        data-label={slide.label}
        data-active={index === 0 ? '' : undefined}
        role="group"
        aria-roledescription="slide"
        aria-label={`${index + 1} of ${slides.length}: ${slide.label}`}
      >
        <ThemedScreenshot shot={slide.shot} shadow="subtle" sizes={sizes} loading="eager" />
      </div>
    ))}

    {slides.length > 1 && (
      <>
        <button
          type="button"
          class="shot-carousel__button shot-carousel__button--prev"
          data-carousel-prev
          aria-label={`Previous: ${label}`}
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M15 6l-6 6 6 6" />
          </svg>
        </button>
        <button
          type="button"
          class="shot-carousel__button shot-carousel__button--next"
          data-carousel-next
          aria-label={`Next: ${label}`}
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M9 6l6 6-6 6" />
          </svg>
        </button>
      </>
    )}
  </div>

  <p class="shot-carousel__caption" data-carousel-caption aria-live="polite">
    {slides[0]?.label}
  </p>
</div>

<script>
  document.querySelectorAll('[data-carousel]').forEach((carousel) => {
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-carousel-slide]')];
    const caption = carousel.querySelector<HTMLElement>('[data-carousel-caption]');
    const prev = carousel.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = carousel.querySelector<HTMLButtonElement>('[data-carousel-next]');
    if (!prev || !next || slides.length < 2) return;

    let index = 0;
    const render = () => {
      slides.forEach((slide, slideIndex) => {
        if (slideIndex === index) {
          slide.setAttribute('data-active', '');
        } else {
          slide.removeAttribute('data-active');
        }
      });
      prev.disabled = index === 0;
      next.disabled = index === slides.length - 1;
      if (caption) caption.textContent = slides[index]?.dataset.label ?? '';
    };

    prev.addEventListener('click', () => {
      index = Math.max(0, index - 1);
      render();
    });
    next.addEventListener('click', () => {
      index = Math.min(slides.length - 1, index + 1);
      render();
    });
    render();
  });
</script>

<style>
  .shot-carousel__stage {
    position: relative;
  }
  /* A fade stage rather than a scroller: an `overflow` container would clip the
   * screenshot's drop shadow, so inactive slides are hidden in place. */
  .shot-carousel__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition: opacity 220ms ease;
  }
  .shot-carousel__slide[data-active] {
    position: relative;
    opacity: 1;
    visibility: visible;
  }
  .shot-carousel__caption {
    margin-top: 0.75rem;
    text-align: center;
    font-size: 0.875rem;
    line-height: 1.5;
    color: color-mix(in oklab, currentColor 70%, transparent);
  }
  .shot-carousel__button {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid rgb(255 255 255 / 22%);
    border-radius: 9999px;
    background: rgb(20 20 24 / 55%);
    color: #fff;
    box-shadow: 0 4px 14px rgb(0 0 0 / 35%);
    backdrop-filter: blur(8px);
    cursor: pointer;
    transform: translateY(-50%);
    transition:
      opacity 140ms ease,
      background-color 140ms ease;
  }
  .shot-carousel__button:hover:not(:disabled) {
    background: rgb(20 20 24 / 78%);
  }
  .shot-carousel__button:disabled {
    opacity: 0;
    pointer-events: none;
  }
  .shot-carousel__button:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }
  .shot-carousel__button svg {
    width: 1.5rem;
    height: 1.5rem;
  }
  .shot-carousel__button--prev {
    left: 0.75rem;
  }
  .shot-carousel__button--next {
    right: 0.75rem;
  }
  @media (prefers-reduced-motion: reduce) {
    .shot-carousel__slide {
      transition: none;
    }
  }
</style>
