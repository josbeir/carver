---
import type { Shot } from '../data/screenshots';
import { base } from '../utils/base';
import ThemedScreenshot from './ThemedScreenshot.astro';
import HeroLogo from './HeroLogo.astro';

interface Props {
  shot?: Shot;
}

const { shot } = Astro.props;

const repo = 'https://github.com/josbeir/carver';
---

<section class="relative flex min-h-[calc(100svh-4rem-1px)] flex-col overflow-hidden">
  <div class="hero-layout mx-auto grid w-full max-w-6xl flex-1 content-center items-start gap-10 px-4 pt-8 pb-8 sm:gap-12 sm:pt-10 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] lg:gap-14">
    <div class="hero-copy relative z-10 min-w-0">
      <div class="hero-logo mb-5 size-28 sm:mb-6 sm:size-32">
        <HeroLogo />
      </div>
      <h1 class="font-sans text-5xl leading-[1.05] font-semibold tracking-tight text-balance sm:text-6xl lg:text-[4.25rem]">
        A little space for big ideas
      </h1>

      <p class="mt-5 max-w-xl text-lg/8 text-base-content/75">
        Carver is a local-first GNOME app that stays out of your way, with the tools you need every
        day. Quick to open and ready to catch an idea, it keeps your notes and images right on your
        own computer.
      </p>

      <div class="mt-6 flex flex-wrap items-center gap-3">
        <a class="btn btn-primary" href={`${base}#install`}>
          Get Carver for Linux
        </a>
        <a class="btn btn-ghost gap-2" href={repo}>
          <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38l-.01-1.49c-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.19c0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
          </svg>
          View on GitHub
        </a>
      </div>
      <p class="mt-4 text-sm/6 text-base-content/60">
        Built with Rust for a fast, responsive feel.
      </p>
    </div>

    {shot && (
      <div class="hero-capture min-w-0 lg:w-[880px] xl:w-[960px]">
        <ThemedScreenshot
          shot={shot}
          loading="eager"
          shadow="subtle"
          sizes="(min-width: 1280px) 960px, (min-width: 1024px) 880px, calc(100vw - 32px)"
        />
      </div>
    )}
  </div>
  <a
    href={`${base}#features`}
    aria-label="Explore Carver’s features"
    class="mx-auto mb-4 flex size-11 shrink-0 items-center justify-center rounded-full text-primary transition-colors hover:bg-primary/10 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-primary"
  >
    <svg
      class="scroll-chevron size-6"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </a>
</section>

<style>
  @media (min-width: 1024px) and (max-height: 800px) {
    .hero-layout {
      padding-top: 24px;
      padding-bottom: 24px;
    }
    .hero-copy > .hero-logo {
      width: 80px;
      height: 80px;
      margin-bottom: 16px;
    }
    .hero-copy h1 {
      font-size: 3.5rem;
    }
    .hero-copy > p:first-of-type {
      font-size: 1rem;
      line-height: 1.75;
    }
    .hero-capture {
      width: min(960px, max(680px, calc((100svh - 12rem) * 1.6)));
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .scroll-chevron {
      animation: chevron-blink 2.4s ease-in-out infinite;
    }
  }

  @keyframes chevron-blink {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.3;
    }
  }
</style>
