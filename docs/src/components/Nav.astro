---
import { base } from '../utils/base';
import ThemeToggle from './ThemeToggle.astro';

const repo = 'https://github.com/josbeir/carver';
---

<header class="sticky top-0 z-40 border-b border-base-300/70 bg-base-100/85 backdrop-blur-md">
  <div class="navbar mx-auto max-w-6xl gap-2 px-4">
    <div class="navbar-start">
      <a
        class="btn btn-ghost gap-2 px-2 text-lg font-semibold tracking-tight"
        href={base}
        aria-label="Carver home"
      >
        <img src={`${base}carver-icon.svg`} alt="" class="size-8 rounded-lg" />
        <span>Carver</span>
      </a>
    </div>

    <nav class="navbar-center hidden md:flex" aria-label="Primary">
      <ul class="menu menu-horizontal gap-1 px-1 text-sm font-medium">
        <li>
          <a href={`${base}#features`}>Features</a>
        </li>
        <li>
          <a href={`${base}#carve`}>Carve source</a>
        </li>
        <li>
          <a href={`${base}#agent`}>Agent access</a>
        </li>
        <li>
          <a href={`${base}#install`}>Install</a>
        </li>
      </ul>
    </nav>

    <div class="navbar-end gap-1">
      <ThemeToggle />
      <a class="btn btn-sm btn-neutral" href={repo}>
        <svg class="size-4" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
          <path d="M8 0C3.58 0 0 3.58 0 8a8 8 0 0 0 5.47 7.59c.4.07.55-.17.55-.38l-.01-1.49c-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.6 7.6 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48l-.01 2.19c0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
        </svg>
        <span class="hidden sm:inline">GitHub</span>
      </a>
    </div>
  </div>
</header>
