---
import 'photoswipe/style.css';
import { shots, type ShotName } from '../data/screenshots';
import ScreenshotCarousel from './ScreenshotCarousel.astro';

const captions: Record<ShotName, string> = {
  editor: 'Write and format freely',
  palette: 'Commands at your fingertips',
  media: 'Images, right in your notes',
  focus: 'Find your focus',
  source: 'Source and preview, side by side',
  bases: 'Bring notes together in Bases',
  agent: 'Connect your assistant',
  library: 'Keep things in order',
  search: 'Find your next thought',
  settings: 'Make yourself at home',
};

const slides = Object.entries(shots).map(([name, shot]) => ({
  label: captions[name as ShotName],
  shot,
}));
---

<section
  id="screenshots"
  class="scroll-mt-24 border-t border-base-300/60 bg-base-200/50 py-12 sm:py-16"
>
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="text-center text-3xl font-semibold tracking-tight sm:text-4xl">
      Take a look around
    </h2>
    <p class="mx-auto mt-3 max-w-3xl text-center text-lg/8 text-base-content/75">
      From a quiet page to a library full of ideas, explore Carver in action. Browse the thumbnails
      and select the large screenshot for a closer look.
    </p>
    <div class="mx-auto mt-8 max-w-5xl">
      <ScreenshotCarousel
        slides={slides}
        label="Carver screenshots"
        sizes="(min-width: 1088px) 1024px, calc(100vw - 32px)"
        thumbnails
        zoom
      />
    </div>
  </div>
</section>

<script>
  import PhotoSwipe from 'photoswipe';
  import PhotoSwipeLightbox from 'photoswipe/lightbox';
  import type Swiper from 'swiper';

  const carousel = document.querySelector<HTMLElement & { swiper?: Swiper }>(
    '#screenshots [data-carousel-main]',
  );

  const lightbox = new PhotoSwipeLightbox({
    gallery: '#screenshots',
    children: 'a[data-gallery-item]',
    // Load the viewer with this script rather than requesting a dev-server module on click.
    pswpModule: PhotoSwipe,
    mainClass: 'carver-lightbox',
    returnFocus: false,
    bgOpacity: 0.94,
    paddingFn: (viewport) => ({
      top: 72,
      bottom: 112,
      left: viewport.x < 640 ? 16 : 64,
      right: viewport.x < 640 ? 16 : 64,
    }),
    closeTitle: 'Close gallery',
    zoomTitle: 'Zoom screenshot',
    arrowPrevTitle: 'Previous screenshot',
    arrowNextTitle: 'Next screenshot',
    errorMsg: 'This screenshot could not be loaded. Close the gallery and try again.',
  });

  // Resolve the theme each time a slide is opened, including after theme changes.
  lightbox.addFilter('domItemData', (data, element, link) => {
    if (link && document.documentElement.dataset.theme === 'carver-dark') {
      data.src = link.dataset.darkSrc;
      data.width = Number(link.dataset.darkWidth);
      data.height = Number(link.dataset.darkHeight);
    }
    const thumbnail = [...element.querySelectorAll('img')].find(
      (img) => img.getBoundingClientRect().width > 0,
    );
    if (thumbnail) {
      data.msrc = thumbnail.currentSrc || thumbnail.src;
      data.alt = thumbnail.alt;
    }
    return data;
  });
  lightbox.addFilter(
    'thumbEl',
    (thumbnail, data) =>
      [...(data.element?.querySelectorAll('img') ?? [])].find(
        (img) => img.getBoundingClientRect().width > 0,
      ) ??
      thumbnail ??
      data.element ??
      document.body,
  );

  lightbox.on('uiRegister', () => {
    lightbox.pswp?.element?.setAttribute('aria-label', 'Carver screenshots');
    lightbox.pswp?.element?.setAttribute('aria-modal', 'true');
    lightbox.pswp?.ui?.registerElement({
      name: 'caption',
      className: 'pswp__caption screenshot-overlay',
      appendTo: 'root',
      isButton: false,
      onInit: (element, pswp) => {
        element.setAttribute('aria-live', 'polite');
        element.setAttribute('aria-atomic', 'true');
        pswp.on('change', () => {
          element.textContent =
            pswp.currSlide?.data.element
              ?.querySelector('[data-gallery-caption]')
              ?.textContent?.trim() ?? '';
        });
      },
    });
  });

  let previousOverflow = '';
  lightbox.on('change', () => {
    const index = lightbox.pswp?.currIndex;
    if (index !== undefined) carousel?.swiper?.slideTo(index, 0);
  });
  lightbox.on('beforeOpen', () => {
    document
      .querySelectorAll<HTMLElement & { swiper?: Swiper }>('[data-carousel-main]')
      .forEach((element) => element.swiper?.keyboard.disable());
    previousOverflow = document.documentElement.style.overflow;
    document.documentElement.style.overflow = 'hidden';
    if (lightbox.pswp) {
      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      lightbox.pswp.options.showAnimationDuration = reducedMotion ? 0 : 280;
      lightbox.pswp.options.hideAnimationDuration = reducedMotion ? 0 : 220;
      lightbox.pswp.options.zoomAnimationDuration = reducedMotion ? 0 : 280;
    }
  });
  lightbox.on('bindEvents', () => {
    lightbox.pswp?.element?.focus({ preventScroll: true });
  });
  lightbox.on('destroy', () => {
    document.documentElement.style.overflow = previousOverflow;
    carousel
      ?.querySelector<HTMLElement>('[data-carousel-slide]:not([inert]) [data-gallery-item]')
      ?.focus({ preventScroll: true });
  });
  lightbox.init();

  const zoom = document.querySelector<HTMLButtonElement>('#screenshots [data-gallery-zoom]');
  if (zoom) {
    zoom.hidden = false;
    zoom.addEventListener('click', () => {
      lightbox.loadAndOpen(carousel?.swiper?.activeIndex ?? 0);
    });
  }
</script>

<style is:global>
  .carver-lightbox {
    --pswp-bg: #102219;
    --pswp-icon-color: #fff8e7;
    --pswp-icon-color-secondary: #17352b;
    --pswp-icon-stroke-color: #17352b;
    --pswp-icon-stroke-width: 1px;
    backdrop-filter: blur(12px);
  }
  .carver-lightbox .pswp__img {
    border-radius: 12px;
  }
  .carver-lightbox .pswp__button:focus-visible {
    outline: 2px solid #8ff0a4;
    outline-offset: -4px;
  }
  .carver-lightbox .pswp__caption {
    position: absolute;
    bottom: max(24px, env(safe-area-inset-bottom));
    left: 50%;
    transform: translateX(-50%);
    width: max-content;
    max-width: calc(100% - 32px);
    pointer-events: none;
  }
</style>
