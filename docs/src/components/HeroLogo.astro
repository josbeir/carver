<svg
  xmlns="http://www.w3.org/2000/svg"
  width="128"
  height="128"
  viewBox="0 0 128 128"
  class="block size-full"
  data-hero-logo
  aria-hidden="true"
  focusable="false"
>
  <path d="M44 24H108V52H48V88H108V116H44L20 92V48Z" fill="#14532e" />
  <path data-paper-highlight="1.5" d="M44 20H108V48H48V84H108V112H44L20 88V44Z" fill="#2ec27e" />
  <path data-paper-highlight="1.5" d="M20 44L48 48V84L20 88Z" fill="#26a269" />
  <path data-paper-highlight="1.12" d="M44 20L48 48L20 44Z" fill="#fff8e7" />
  <path data-paper-highlight="1.12" d="M80 84H108V112Z" fill="#fff8e7" />
  <path data-paper-highlight="1.3" d="M80 84L108 112H80Z" fill="#ded4b8" />
</svg>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  for (const logo of document.querySelectorAll<SVGSVGElement>('[data-hero-logo]')) {
    if (!('IntersectionObserver' in window) || !('animate' in Element.prototype)) continue;
    let visible = false;
    let animations: Animation[] = [];

    const update = () => {
      if (reducedMotion.matches) {
        animations.forEach((animation) => animation.cancel());
        animations = [];
        return;
      }
      const running = visible && !document.hidden;
      if (running && animations.length === 0) {
        animations = [...logo.querySelectorAll<SVGPathElement>('[data-paper-highlight]')].map(
          (shape, index) => {
            const start = index * 0.065;
            return shape.animate(
              [
                { filter: 'brightness(1)', offset: 0 },
                { filter: 'brightness(1)', offset: start, easing: 'ease-in-out' },
                {
                  filter: `brightness(${shape.dataset.paperHighlight})`,
                  offset: start + 0.07,
                  easing: 'ease-in-out',
                },
                { filter: 'brightness(1)', offset: start + 0.14 },
                { filter: 'brightness(1)', offset: 1 },
              ],
              { duration: 6000, delay: 1000, iterations: Infinity },
            );
          },
        );
      }
      animations.forEach((animation) => (running ? animation.play() : animation.pause()));
    };

    const observer = new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      update();
    });
    observer.observe(logo);
    document.addEventListener('visibilitychange', update);
    reducedMotion.addEventListener('change', update);
  }
</script>
