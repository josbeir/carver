---
import BaseLayout from '../layouts/BaseLayout.astro';
import { base } from '../utils/base';
---

<BaseLayout
  title="Page not found — Carver"
  description="The page you were looking for does not exist."
>
  <section class="mx-auto flex max-w-2xl flex-col items-center px-4 py-28 text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-primary">404</p>
    <h1 class="mt-3 text-4xl font-semibold tracking-tight text-balance">This page wandered off</h1>
    <p class="mt-4 text-base/7 text-base-content/75">
      The page you were looking for does not exist, or it moved somewhere else.
    </p>
    <a class="btn btn-primary mt-8" href={base}>
      Back to Carver
    </a>
  </section>
</BaseLayout>
