---
import FeatureShowcase from '../components/FeatureShowcase.astro';
import Hero from '../components/Hero.astro';
import InstallBlock from '../components/InstallBlock.astro';
import { shots } from '../data/screenshots';
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Carver — A native GNOME home for notes that last';
const description =
  'Carver is a native GNOME note-taking app written in Rust: rich-text and Carve source editing, saved Bases, managed images, and optional local agent access. Your notes stay on your machine.';

const guarantees = [
  {
    title: 'Your files stay yours',
    body: 'Notes live in an XDG-scoped SQLite library on your machine, with images kept as managed assets next to the source. No account, no sync service, no telemetry.',
  },
  {
    title: 'Built with Rust and GTK',
    body: 'A real desktop application that follows GNOME: responsive Libadwaita layouts, light and dark themes, and accessible, keyboard-friendly controls.',
  },
  {
    title: 'Open source, MIT licensed',
    body: 'Read the code, build it yourself, or package it for your distribution. Canonical Carve source means your writing is never locked in.',
  },
];
---

<BaseLayout title={title} description={description}>
  <Hero shot={shots.editor} />
  <FeatureShowcase />

  <section id="why" class="scroll-mt-24 border-t border-base-300/60 py-20 sm:py-24">
    <div class="mx-auto max-w-6xl px-4">
      <ul class="grid gap-10 sm:grid-cols-3">
        {guarantees.map((item) => (
          <li>
            <h2 class="text-xl font-semibold">{item.title}</h2>
            <p class="mt-3 text-base/7 text-base-content/70">{item.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <InstallBlock />
</BaseLayout>
