---
import CarveSection from '../components/CarveSection.astro';
import FeatureShowcase from '../components/FeatureShowcase.astro';
import Hero from '../components/Hero.astro';
import InstallBlock from '../components/InstallBlock.astro';
import { shots, type Shot, type ShotName } from '../data/screenshots';
import BaseLayout from '../layouts/BaseLayout.astro';

const heroOrder: ShotName[] = ['editor', 'source', 'bases', 'agent', 'library', 'settings'];
const heroShots = heroOrder
  .map((name) => shots[name])
  .filter((shot): shot is Shot => Boolean(shot));

const title = 'Carver — A little space for big ideas';
const description =
  'Make room for your next idea. Carver brings writing, organizing, and finding your notes together in a calm desktop app. Free, open source, and yours to keep.';
---

<BaseLayout title={title} description={description} backdrop>
  <Hero shots={heroShots} />
  <FeatureShowcase />
  <CarveSection />
  <InstallBlock />
</BaseLayout>
