    <context id="fence-typescript" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:ts|typescript)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="typescript:typescript"/></include></context></include></context>
    <context id="fence-php" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:php)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="php:cpp-line-comment"/><context ref="php:bash-line-comment"/><context ref="php:c-block-comment"/><context ref="php:double-quoted-string"/><context ref="php:single-quoted-string"/><context ref="php:backtick-string"/><context ref="php:here-doc-string"/><context ref="php:here-doc-string-double-quotes"/><context ref="php:now-doc-string"/><context ref="php:variable"/><context ref="php:array-operators"/><context ref="php:keywords"/><context ref="php:common-function"/><context ref="php:operators"/><context ref="php:type"/><context ref="php:null-value"/><context ref="php:boolean"/><context ref="php:float"/><context ref="php:decimal-number"/><context ref="php:octal-number"/><context ref="php:hexadecimal-number"/><context ref="php:identifier"/></include></context></include></context>
    <context id="fence-python" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:py|python|python3)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="python3:python3"/></include></context></include></context>
    <context id="fence-rust" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:rs|rust)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="rust:rust"/></include></context></include></context>
    <context id="fence-sh" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:sh|bash|shell|zsh)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="sh:sh"/></include></context></include></context>
    <context id="fence-json" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:json)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="json:json"/></include></context></include></context>
    <context id="fence-yaml" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:ya?ml)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="yaml:yaml"/></include></context></include></context>
    <context id="fence-html" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:html?)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="html:html"/></include></context></include></context>
    <context id="fence-xml" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:xml|svg)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="xml:xml"/></include></context></include></context>
    <context id="fence-css" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:css)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="css:css"/></include></context></include></context>
    <context id="fence-sql" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:sql)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="sql:sql"/></include></context></include></context>
    <context id="fence-markdown" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:md|markdown)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="markdown:markdown"/></include></context></include></context>
    <context id="fence-c" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:c|h)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="c:c"/></include></context></include></context>
    <context id="fence-cpp" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:cpp|c\+\+|cc|hpp)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="cpp:cpp"/></include></context></include></context>
    <context id="fence-go" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:go|golang)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="go:go"/></include></context></include></context>
    <context id="fence-java" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:java)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="java:java"/></include></context></include></context>
    <context id="fence-ruby" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:rb|ruby)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="ruby:ruby"/></include></context></include></context>
    <context id="fence-toml" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,})[ \t]*(?:toml)(?=[ \t{]|$).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context class="carve-code-line" end-at-line-end="true"><start>^(?![ \t]*(?:\x60{3,}|~{3,})[ \t]*$)(?=.)</start><include><context ref="toml:toml"/></include></context></include></context>
    <context id="fence" style-ref="code-block" class="carve-code-block"><start>^[ \t]*(\x60{3,}|~{3,}).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end></context>
    <context id="diff-fence" class="carve-code-block" end-parent="true"><start>^[ \t]*(\x60{3,}|~{3,}).*$</start><end>^[ \t]*\%{1@start}[\x60~]*[ \t]*$</end><include><context sub-pattern="0" where="start" style-ref="code-block"/><context sub-pattern="0" where="end" style-ref="code-block"/><context ref="diff-line"/></include></context>
